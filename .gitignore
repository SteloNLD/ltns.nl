zola/content/
quartz/content/

# SSG static (copied at build time from static/)
hugo/static/
zola/static/

# SSG build output
hugo/public/
hugo/.hugo_build.lock
zola/public/
quartz/public/

# Node (Quartz)
node_modules/

# macOS
.DS_Store
